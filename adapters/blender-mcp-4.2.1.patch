+def tools_c_check(project: Optional[str] = None) -> Dict[str, Any]:
+    """Run canonical read-only L1 checks for an explicitly registered project.
+
+    Omitting project checks Tools_C. No Blender connection or shell is required.
+    Runtime and visual acceptance remain NOT_EVALUATED.
