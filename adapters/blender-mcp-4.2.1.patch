+        allowed=helper['registered_projects'](root,Path(__file__).resolve().parent.parent)
+        return helper['run_checks'](root,project,allowed_projects=allowed)
+    except Exception as exc:
+        return dict(ok=False,code='E_CHECK_CONFIG',error=str(exc))
