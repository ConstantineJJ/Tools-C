{
  "schema_version": 1,
  "id": "surface-transfer",
  "rules": [
    {
      "id": "RST-REGISTRATION",
      "kind": "json_subset",
      "paths": [
        "manifest.json"
      ],
      "expected": {
        "skills": [
          {
            "id": "blender-reference-surface-transfer",
            "path": "skills/blender-reference-surface-transfer/SKILL.md"
          }
        ]
      }
    },
    {
      "id": "RST-PROFILE",
      "kind": "json_subset",
      "paths": [
        ".tooling/profile.json"
      ],
      "expected": {
        "skills": [
          "blender-reference-surface-transfer"
        ],
        "contracts": [
          ".tooling/contracts.json",
          ".tooling/surface-transfer-contracts.json"
        ]
      }
    },
    {
      "id": "RST-ENTRYPOINTS",
      "kind": "markdown",
      "paths": [
        "docs/skills.md",
        "skills/blender-pipeline/SKILL.md",
        "skills/visual-reference-reconstruction/SKILL.md",
        "skills/blender-pipeline/references/surfaces.md",
        "skills/blender-posteffects-polishing/SKILL.md"
      ],
      "required_targets": [
        "skills/blender-reference-surface-transfer/SKILL.md"
      ]
    },
    {
      "id": "RST-DEPENDENCIES",
      "kind": "markdown",
      "paths": [
        "skills/blender-reference-surface-transfer/SKILL.md"
      ],
      "required_targets": [
        "docs/foundation.md",
        "skills/blender-pipeline/references/surfaces.md",
        "skills/visual-reference-reconstruction/SKILL.md",
        "skills/blender-reference-surface-transfer/references/workflow.md",
        "skills/blender-reference-surface-transfer/references/record.md"
      ]
    },
    {
      "id": "RST-FILES",
      "kind": "files",
      "paths": [
        "tools/surface_transfer.py",
        "tests/test_surface_transfer.py"
      ]
    },
    {
      "id": "RST-LINKS",
      "kind": "markdown",
      "paths": [
        "skills/blender-reference-surface-transfer/references/workflow.md",
        "skills/blender-reference-surface-transfer/references/record.md"
      ]
    }
  ]
}
